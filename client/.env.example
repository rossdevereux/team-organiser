# Firebase Web Client SDK Configuration
# Replace these values with your Firebase Project Settings -> Web App config
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=team-organiser-prod.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=team-organiser-prod
VITE_FIREBASE_STORAGE_BUCKET=team-organiser-prod.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional Telemetry & Diagnostics Flags (Disabled by default in local dev, enabled in PROD)
# VITE_ENABLE_ANALYTICS=true
# VITE_ENABLE_PERF=true
# VITE_DEBUG_ANALYTICS=true
# VITE_DEBUG_PERF=true
