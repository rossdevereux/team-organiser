PORT=8080
NODE_ENV=development
# Initial Owner Bootstrapping: Users authenticating with this email automatically receive { role: 'owner' }
INITIAL_ADMIN_EMAIL=admin@therovers.local
# Optional Firebase Admin credentials (uses Application Default Credentials on Cloud Run)
FIREBASE_PROJECT_ID=team-organiser-prod

# Stripe Billing & Subscriptions (Optional: runs in simulated mode if omitted)
# Stripe Secret API Key (sk_test_... or sk_live_...)
STRIPE_SECRET_KEY=sk_test_...
# Stripe Webhook Signing Secret (whsec_...) from Stripe Dashboard or CLI
STRIPE_WEBHOOK_SECRET=whsec_...
